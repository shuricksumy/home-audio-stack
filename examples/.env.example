# Copy to .env and edit. `docker compose` reads it automatically.

# The machine running Music Assistant. Everything points at this.
# Use the LAN address, not 127.0.0.1: the containers on a bridge network
# need to reach it too.
HOST_IP=192.168.1.50

# Static address for LedFx on the npm_proxy network (optional, but it keeps
# the WLED devices pointed somewhere stable).
IP_LEDFX=172.112.0.20

# The uid that owns the host's PipeWire socket -- `id -u` on the desktop user.
PUID=1000

# Password for the Bluetooth panel. Empty disables auth entirely, which is only
# sane on a trusted LAN. Do not reuse a password from anywhere else.
BT_ADMIN_PASSWORD=changeme

# Password for the squeezelite and Snapcast panels (ADMIN_USER is `admin` in
# the compose file). They create and delete players, so treat this like a login,
# not a formality -- or drop both ADMIN_ lines to run them open on a trusted LAN.
PANEL_PASSWORD=changeme
